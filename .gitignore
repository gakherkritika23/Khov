# Dependencies
node_modules/

# Environment files — contain secrets (RP_API_KEY), never commit. Real values
# live locally (developer-owned) and in GitHub Environments for CI. The tracked
# example.env template documents which keys are required.
environment/*.env
!environment/example.env

# Playwright test output — generated at runtime, must NOT be committed.
results.xml
playwright-report/
test-results/
allure-results/
allure-report/
client-report/index.html

# Email body generated by CI
email-body.html

# TypeScript build output
dist/
*.js.map

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json
# logs
debug.log

# Docs folder — local reference material only, never commit
docs/

# Claude Code config — skills and local settings, never commit
.claude/
scripts/coverage-summary.html

# Claude Code runtime
.claude/scheduled_tasks.lock