{
  "name": "khovplaywright",
  "version": "1.0.0",
  "description": "Playwright automation framework for khov.com",
  "main": "index.js",
  "scripts": {
    "test:dev": "cross-env TEST_ENV=dev npx playwright test",
    "test:uat": "cross-env TEST_ENV=uat npx playwright test",
    "test:prod": "cross-env TEST_ENV=prod npx playwright test",
    "smoke:dev": "cross-env TEST_ENV=dev npx playwright test --project=smoke",
    "smoke:uat": "cross-env TEST_ENV=uat npx playwright test --project=smoke",
    "smoke:prod": "cross-env TEST_ENV=prod npx playwright test --project=smoke",
    "regression:dev": "cross-env TEST_ENV=dev npx playwright test --project=regression",
    "regression:uat": "cross-env TEST_ENV=uat npx playwright test --project=regression",
    "regression:prod": "cross-env TEST_ENV=prod npx playwright test --project=regression",
    "test:report:dev": "cross-env TEST_ENV=dev node scripts/test-and-report.mjs",
    "test:report:uat": "cross-env TEST_ENV=uat node scripts/test-and-report.mjs",
    "test:report:prod": "cross-env TEST_ENV=prod node scripts/test-and-report.mjs",
    "report:client": "ts-node scripts/generate-client-report.ts",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/node": "^25.2.0",
    "allure-commandline": "^2.37.0",
    "allure-js-commons": "^3.4.5",
    "allure-playwright": "^3.5.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.1"
  },
  "dependencies": {
    "dotenv": "^17.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}