# Environment file template — copy to dev.env / uat.env / stage.env / prod.env
# and fill in real values. These files are gitignored (see .gitignore); only
# this template is tracked. In CI the same keys are injected from GitHub
# Environments (Variables + the RP_API_KEY Secret), so no .env file is used there.

# Environment name (dev | uat | stage | prod).
ENV=dev

# Base URL under test — REQUIRED. playwright.config.ts fails fast if unset.
#   dev   -> https://www-dev.khov.com
#   uat   -> https://www-uat.khov.com
#   stage -> https://www-stg.khov.com
#   prod  -> https://www.khov.com/
BASE_URL=https://www-dev.khov.com

# ReportPortal (optional). Reporting activates only when RP_API_KEY is set;
# leave RP_API_KEY blank to run without ReportPortal.
RP_ENDPOINT=https://<your-reportportal-host>/api/v1
RP_PROJECT=khov
RP_API_KEY=
